# ==========================================
# Configuración General del Entorno
# ==========================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==========================================
# Base de Datos (PostgreSQL 16 + pgvector)
# ==========================================
POSTGRES_USER=jobfinder
POSTGRES_PASSWORD=jobfinder_secret_change_me
POSTGRES_DB=jobfinder_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ==========================================
# Cola de Tareas & Caché (Redis 7)
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ==========================================
# APIs Externas de Ofertas de Empleo
# ==========================================
# Adzuna API (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble API (https://jooble.org/api/about)
JOOBLE_API_KEY=

# InfoJobs Developer (https://developer.infojobs.net/)
INFOJOBS_CLIENT_ID=
INFOJOBS_CLIENT_SECRET=

# ==========================================
# Proveedores de LLM
# ==========================================
# Google Gemini (Gemini Flash)
GEMINI_API_KEY=

# Anthropic Claude (Claude Haiku)
ANTHROPIC_API_KEY=

# ==========================================
# Bot de Telegram (Aiogram 3.x)
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ==========================================
# Reverse Proxy & Dominio (Caddy)
# ==========================================
DOMAIN_NAME=localhost
CADDY_EMAIL=admin@example.com
